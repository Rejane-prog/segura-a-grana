# Copie este arquivo para .env e ajuste se precisar.
# Nenhum segredo deve ser versionado: o .env está no .gitignore.

# Porta do servidor (padrão: 3000)
PORT=3000

# Caminho do banco SQLite (padrão: segura-a-grana.db na raiz do projeto)
# Use :memory: para um banco temporário em memória
DB_PATH=segura-a-grana.db
